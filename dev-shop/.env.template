# Copy to .env and fill in. Never commit .env.
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9055,http://127.0.0.1:9055
AUTH_CORS=http://localhost:5173,http://localhost:9055,http://127.0.0.1:9055
REDIS_URL=
JWT_SECRET=
COOKIE_SECRET=
DATABASE_URL=postgres://postgres:<password>@localhost:5432/medusify_devshop
PORT=9055
DISABLE_MEDUSA_ADMIN=true

# From: npx web-push generate-vapid-keys  (private key stays secret)
MEDUSIFY_VAPID_PUBLIC_KEY=
MEDUSIFY_VAPID_PRIVATE_KEY=
MEDUSIFY_VAPID_SUBJECT=mailto:dev@example.invalid
# 64 random characters, e.g. openssl rand -hex 32 (needed for MFA)
AUTH_MFA_ENCRYPTION_KEY=

# Optional: serve the PWA build from this folder instead of the one inside the plugin package
# MEDUSIFY_PWA_DIR=/abs/path/to/plugin/pwa-dist

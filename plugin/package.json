{
  "name": "medusify",
  "version": "0.2.1",
  "description": "Medusa v2 plugin: web push for new orders, dashboard routes and a hosted PWA (the Medusify app) under /medusify.",
  "license": "MIT",
  "author": "Andreas Filimon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreasfilimon/medusify.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/andreasfilimon/medusify#readme",
  "bugs": {
    "url": "https://github.com/andreasfilimon/medusify/issues"
  },
  "keywords": [
    "medusa",
    "medusa-v2",
    "medusa-plugin",
    "medusa-plugin-notification",
    "medusa-plugin-other",
    "web-push",
    "push-notifications",
    "pwa",
    "ios",
    "admin",
    "ecommerce"
  ],
  "files": [
    ".medusa/server",
    "pwa-dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./workflows": "./.medusa/server/src/workflows/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    },
    "./*": "./.medusa/server/src/*.js"
  },
  "scripts": {
    "build": "medusa plugin:build && node scripts/strip-inline-source-maps.mjs",
    "dev": "medusa plugin:develop",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "medusa plugin:db:generate",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit"
  },
  "dependencies": {
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.22.7",
    "@medusajs/cli": "2.22.7",
    "@medusajs/framework": "2.22.7",
    "@medusajs/icons": "2.22.7",
    "@medusajs/medusa": "2.22.7",
    "@medusajs/test-utils": "2.22.7",
    "@medusajs/ui": "4.2.9",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "@types/web-push": "^3.6.4",
    "jest": "^29.7.0",
    "jsonwebtoken": "^9.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": ">=2.22.0 <2.23.0",
    "@medusajs/cli": ">=2.22.0 <2.23.0",
    "@medusajs/framework": ">=2.22.0 <2.23.0",
    "@medusajs/medusa": ">=2.22.0 <2.23.0"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "ajv": "^8.18.0"
  }
}

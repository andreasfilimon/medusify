{
  "compilerOptions": {
    "target": "ES2021",
    "esModuleInterop": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "declaration": true,
    "sourceMap": false,
    "outDir": "./.medusa/server",
    "rootDir": ".",
    "jsx": "react-jsx",
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "checkJs": false,
    "strictNullChecks": true
  },
  "include": ["src"],
  "exclude": [
    "**/__tests__",
    "integration-tests",
    "node_modules",
    ".medusa",
    "dist",
    "pwa-dist",
    "src/admin"
  ]
}
